# Copy to .env. Nothing here has to be filled in by hand: the app asks for the
# lifter profile on first run and writes your answers back to this file.

# --- lifter profile ---
# Left commented out on purpose. A commented-out key is *unset*, which the app
# can tell apart from a value you chose - that is what makes it offer the setup
# form and what makes the strength page admit when a number is a stand-in. Give
# a key a value here and the app takes it as your answer.
#
# Every strength standard is indexed on bodyweight and sex, so those two decide
# which band each lift lands in; TRAINING_GOAL drives every volume and frequency
# threshold in goals.py. The rest are refinements.
#
# SEX=male                  # male | female
# BODYWEIGHT_KG=82          # in kg. A logged body measurement outranks this.
# TRAINING_GOAL=hypertrophy # hypertrophy | strength | powerlifting
# BIRTH_DATE=1995-06-01     # enables the age adjustment on the standards
# DUMBBELL_LOAD=per_dumbbell  # per_dumbbell | combined - how you type a two-dumbbell load
# UNITS=kg                  # kg | lb - display only; everything is stored in kg

# --- the AI coach ---
# Only needed for `hevy-coach ask` and the Coach page. Leave unset to use the
# SDK's own credential chain (ANTHROPIC_API_KEY, then an `ant auth login` profile).
# ANTHROPIC_API_KEY=sk-ant-...
# COACH_MODEL=claude-opus-5
# COACH_EFFORT=high        # low | medium | high | xhigh | max

# --- paths and server ---
# WORKOUTS_DIR=./workouts       # the newest *.csv here is what gets imported
# DATABASE_PATH=./data/hevy.db
# CORS_ORIGINS=http://localhost:3000
