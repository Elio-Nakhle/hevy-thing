# Copy to .env. Every value here is optional except your body stats, which place
# your lifts on the strength-standard curves.

# --- lifter profile ---
SEX=male                  # male | female
# Not optional in practice: every strength standard is indexed on bodyweight, so
# leaving this unset falls back to a placeholder 80 kg and shifts your levels by
# whole bands. Overridden by a logged body measurement, if there is one.
BODYWEIGHT_KG=55
DUMBBELL_LOAD=combined    # per_dumbbell | combined - how you type a two-dumbbell load
BIRTH_DATE=1995-06-01     # enables the age adjustment on the standards
UNITS=kg                  # kg | lb - display only; everything is stored in kg

# --- the AI coach ---
# Only needed for `hevy-coach ask` and the Coach page. Leave unset to use the
# SDK's own credential chain (ANTHROPIC_API_KEY, then an `ant auth login` profile).
# ANTHROPIC_API_KEY=sk-ant-...
# COACH_MODEL=claude-opus-5
# COACH_EFFORT=high        # low | medium | high | xhigh | max

# --- paths and server ---
# WORKOUTS_DIR=./workouts       # the newest *.csv here is what gets imported
# DATABASE_PATH=./data/hevy.db
# CORS_ORIGINS=http://localhost:3000
